generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String            @unique
  color           String            @default("#6366f1")
  createdAt       DateTime          @default(now())
  paidExpenses    Expense[]         @relation("PaidBy")
  splits          ExpenseSplit[]
  recurringPaid   RecurringExpense[] @relation("RecurringPaidBy")
  recurringSplits RecurringSplit[]
  settlementsFrom Settlement[]      @relation("SettlementsFrom")
  settlementsTo   Settlement[]      @relation("SettlementsTo")
}

model Expense {
  id          String            @id @default(cuid())
  description String
  amountCents Int
  category    String            @default("general")
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())
  paidById    String
  recurringId String?
  paidBy      User              @relation("PaidBy", fields: [paidById], references: [id])
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  shareCents Int
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model RecurringExpense {
  id          String           @id @default(cuid())
  description String
  amountCents Int
  category    String           @default("general")
  paidById    String
  createdAt   DateTime         @default(now())
  paidBy      User             @relation("RecurringPaidBy", fields: [paidById], references: [id])
  splits      RecurringSplit[]
  expenses    Expense[]
}

model RecurringSplit {
  id          String           @id @default(cuid())
  recurringId String
  userId      String
  recurring   RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recurringId, userId])
}

model Settlement {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())
  fromUser    User     @relation("SettlementsFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("SettlementsTo", fields: [toUserId], references: [id])
}
